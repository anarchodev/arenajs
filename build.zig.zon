.{
    .name = .arenajs,
    .version = "0.3.0",
    .fingerprint = 0x63674e5469b18241,
    .minimum_zig_version = "0.15.0",
    .dependencies = .{},
    .paths = .{
        "build.zig",
        "build.zig.zon",
        // Runtime translation units compiled into the static lib.
        "quickjs.c",
        "qjs-arena.c",
        "libregexp.c",
        "libunicode.c",
        "dtoa.c",
        // Native replay/trace host TUs — compiled (with ARENA_TRACE_ENABLED=1)
        // into the `arenajs-replay` artifact for native replay/simulation
        // embedders (see build.zig). The browser path builds them via CMake.
        "qjs-arena-reactor.c",
        "qjs-arena-replay-bindings.c",
        "qjs-arena-trace.c",
        // All root headers (every transitive include is flat at root).
        "builtin-array-fromasync.h",
        "builtin-iterator-zip-keyed.h",
        "builtin-iterator-zip.h",
        "cutils.h",
        "dtoa.h",
        "libregexp-opcode.h",
        "libregexp.h",
        "libunicode-table.h",
        "libunicode.h",
        "list.h",
        "qjs-arena-replay-bindings.h",
        "qjs-arena-trace.h",
        "qjs-arena.h",
        "quickjs-atom.h",
        "quickjs-c-atomics.h",
        "quickjs-libc.h",
        "quickjs-opcode.h",
        "quickjs.h",
        "unicode_gen_def.h",
    },
}
